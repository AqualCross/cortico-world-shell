{
  "name": "cortico-world-shell",
  "version": "0.1.0",
  "type": "module",
  "description": "Cortico World: run Niubash (bash) commands one process at a time, with a native approval box and an optional RTK hint",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "shell",
    "terminal",
    "bash",
    "niubash",
    "niu"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "Shell",
    "describe": "describe.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:powershell": "tsx scripts/smoke-powershell.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "koffi": "3.3.1"
  }
}
