{
  "name": "cortico-world-shell",
  "version": "0.1.0",
  "type": "module",
  "description": "Shell —— 给 Coopanion 桌宠的 cortico World 扩展：让 Coo 在你的电脑上执行 PowerShell 命令，是否先问、多久问一次都由你掌握。 / A cortico World extension that lets Coo run PowerShell commands on your PC, with approval under your control.",
  "license": "MIT",
  "author": {
    "name": "AqualCross"
  },
  "homepage": "https://github.com/AqualCross/cortico-world-shell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AqualCross/cortico-world-shell.git"
  },
  "bugs": {
    "url": "https://github.com/AqualCross/cortico-world-shell/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "shell",
    "powershell",
    "pwsh",
    "windows",
    "bash",
    "niubash",
    "niu"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "Shell",
    "describe": "describe.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:powershell": "tsx scripts/smoke-powershell.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "koffi": "3.3.1"
  }
}
